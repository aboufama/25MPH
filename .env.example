# Copy this file to ".env" and fill in your Stripe keys.
# Get them at https://dashboard.stripe.com/apikeys (use the "test" keys first).

# Secret key — used by the backend to create Checkout Sessions. Keep private.
# (starts with "sk_test_" for test mode)
STRIPE_SECRET_KEY=

# Port the Express/Stripe backend listens on (optional, defaults to 4242).
PORT=4242

# The public URL of the site, used to build Stripe success/cancel redirect
# URLs. In local dev this is your Vite server. Change for production.
PUBLIC_URL=http://localhost:5173
